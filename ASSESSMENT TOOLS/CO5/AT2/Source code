
import itertools
import time


PSEUDOCODE = r"""
ALGORITHM GraphColoring(graph, M)
------------------------------------------------------------
INPUT : graph  -> adjacency matrix graph[n][n], graph[i][j] = 1 if edge (i,j) exists
        M      -> number of colors available
OUTPUT: color[0..n-1] such that no two adjacent vertices share a color,
        or "NO SOLUTION" if impossible

 1  n <- number of vertices in graph
 2  color[0..n-1] <- 0                      // 0 means "uncolored"
 3
 4  FUNCTION isSafe(vertex, c, color):           // validation function
 5      FOR each u in 0..n-1:
 6          IF graph[vertex][u] == 1 AND color[u] == c:
 7              RETURN false                 // adjacent vertex already has color c
 8      RETURN true
 9
10  FUNCTION solve(vertexIndex, color):            // recursive backtracking
11      IF vertexIndex == n:                       // BASE CASE: all vertices colored
12          RETURN true                            // a complete valid coloring found
13
14      FOR c <- 1 TO M:                            // try each color for this vertex
15          IF isSafe(vertexIndex, c, color):        // constraint check
16              color[vertexIndex] <- c              // tentative assignment (choose)
17
18              IF solve(vertexIndex + 1, color):     // recurse to next vertex
19                  RETURN true                       // propagate success upward
20
21              color[vertexIndex] <- 0               // undo assignment (backtrack)
22      RETURN false                                  // no color worked at this vertex
23
24  MAIN:
25      IF solve(0, color) == true:
26          PRINT color[]                     // valid M-coloring found
27      ELSE:
28          PRINT "NO SOLUTION"                // graph is not M-colorable
------------------------------------------------------------
"""

def is_safe(vertex, c, color, adj):
    """Validation function: can vertex legally take color c right now?
       Checks only ALREADY-colored neighbours (constraint checking)."""
    for u in adj[vertex]:
        if color[u] == c:
            return False
    return True


def solve(vertex_index, color, adj, n, M):
    """Recursive backtracking core."""
    if vertex_index == n:                 # base case: all vertices assigned
        return True

    for c in range(1, M + 1):             # loop over candidate colors
        if is_safe(vertex_index, c, color, adj):   # condition check / pruning
            color[vertex_index] = c                # choose
            if solve(vertex_index + 1, color, adj, n, M):  # recurse
                return True
            color[vertex_index] = 0                # un-choose (backtrack)
    return False                            # trigger backtracking one level up


def graph_coloring(n, edges, M):
    """
    n     : number of vertices (0..n-1)
    edges : list of (u, v) tuples
    M     : number of colors
    returns color list (1-indexed colors) or None if not M-colorable
    """
    adj = {i: [] for i in range(n)}
    for u, v in edges:
        adj[u].append(v)
        adj[v].append(u)

    color = [0] * n
    if solve(0, color, adj, n, M):
        return color
    return None

def brute_force_coloring_exists(n, edges, M):
    for assignment in itertools.product(range(1, M + 1), repeat=n):
        if all(assignment[u] != assignment[v] for u, v in edges):
            return assignment
    return None


def is_valid_coloring(n, edges, color):
    if color is None or len(color) != n:
        return False
    return all(color[u] != color[v] for u, v in edges)


