import math

def T(n):
    if n <= 1:
        return 1
    return 4 * T(n // 2) + n * math.log2(n)

# Test for different network sizes
print("n\tT(n)")
for n in [2, 4, 8, 16, 32, 64, 128]:
    print(f"{n}\t{T(n):.2f}")

print("\nBy Master Theorem (a=4, b=2, f(n)=n log n):")
print("n^(log_b a) = n^2, and n log n = O(n^2)")
print("=> Case 1 applies => T(n) = Theta(n^2)")
